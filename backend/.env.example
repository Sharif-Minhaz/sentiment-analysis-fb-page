# Copy to .env and fill in, or run:  uv run python get_token.py
#
# Get these from https://developers.facebook.com
# Required permissions: pages_show_list, pages_read_engagement, pages_read_user_content
#
# FB_PAGE_ACCESS_TOKEN is a Page token (never expires), NOT a User token.
# Treat it like a password - it is gitignored for that reason.
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
